# ==============================================================================
# AMBIENTE & BANCO DE DADOS (DUAL-DATABASE SETUP)
# ==============================================================================
# Alternar entre: "sqlite" (desenvolvimento local offline) ou "supabase" (produção)
DB_PROVIDER=sqlite

# Configuração SQLite (Local)
SQLITE_DB_URL="file:local.db"

# Configuração Supabase PostgreSQL (Produção - porta 6543 para Transaction Pooler)
# Exemplo: postgresql://postgres.[REF]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=""

# ==============================================================================
# AUTENTICAÇÃO (Auth.js / NextAuth v5)
# ==============================================================================
AUTH_SECRET="super-secret-at-least-32-chars-long-security-key-123456"
AUTH_URL="http://localhost:3000"

# ==============================================================================
# GOOGLE / GMAIL OAUTH (Login Social)
# ==============================================================================
# Obtenha em: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# URI de Redirecionamento Autorizado: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ==============================================================================
# DISPARO DE E-MAILS DE CONFIRMAÇÃO & NOTIFICAÇÕES (Nodemailer / Gmail SMTP)
# ==============================================================================
# Para usar o Gmail:
# 1. Ative a "Verificação em 2 etapas" na sua Conta Google.
# 2. Crie uma "Senha de App" em: https://myaccount.google.com/apppasswords
# 3. Insira o e-mail e a senha de 16 dígitos gerada abaixo.
# Nota: Se deixado em branco, o sistema simula o envio no terminal sem quebrar a aplicação!
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BolsaAlert <no-reply@bolsaalert.com>"

# E-mail onde você deseja receber as notificações de novos cadastros e confirmações
ADMIN_NOTIFICATION_EMAIL=""

# ==============================================================================
# MERCADO FINANCEIRO & COTAÇÕES (MarketDataService)
# ==============================================================================
# Token gratuito da Brapi (https://brapi.dev) para cotações em tempo real da B3
BRAPI_TOKEN=""

# URL pública da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"
